#!/usr/bin/env bash
# labctl - manages the student pods of the Kubernetes-App.
#
# Runs on the VM (as root, uses /etc/rancher/k3s/k3s.yaml) or locally with an
# admin kubeconfig:   KUBECONFIG=./kurs.kubeconfig labctl list
#
# All state lives in the cluster (namespace "lab"): Deployment, Service,
# Secret and PVC per student, the network modes as namespace labels. The file
# /etc/kubernetes-app/students.tsv is only read by `labctl sync` on first boot.
set -euo pipefail

NAMESPACE="${LAB_NAMESPACE:-lab}"
LAB_ENV_FILE="${LAB_ENV_FILE:-/etc/kubernetes-app/lab.env}"
STUDENTS_FILE="${STUDENTS_FILE:-/etc/kubernetes-app/students.tsv}"
FIRST_PORT=30001
LAST_PORT=32767

# Defaults, overridable by lab.env or the environment.
LAB_IMAGE="kubernetes-app/student:1"
# Request = limit: every pod gets its resources guaranteed. Terraform checks
# at plan time that all students fit on the flavor.
POD_CPU="0.5"
POD_MEMORY="1Gi"
POD_DISK="5Gi"
POD_EPHEMERAL_LIMIT="2Gi"
CLUSTER_CIDR_V4="10.42.0.0/16"
CLUSTER_CIDR_V6="fd00:42::/56"
SERVICE_CIDR_V4="10.43.0.0/16"
SERVICE_CIDR_V6="fd00:43::/112"
# Initial network modes. After first boot the namespace labels win.
POD_TO_POD="false"
POD_INTERNET="true"
CAMPUS_CIDR_V4="141.72.0.0/16"
CAMPUS_CIDR_V6="2001:7c0::/32"
PEER_LABEL="kubernetes-app/peer-access"
INTERNET_LABEL="kubernetes-app/internet"

if [ -r "${LAB_ENV_FILE}" ]; then
    # shellcheck disable=SC1090
    . "${LAB_ENV_FILE}"
fi

if [ -z "${KUBECONFIG:-}" ] && [ -r /etc/rancher/k3s/k3s.yaml ]; then
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
fi

kc() { kubectl "$@"; }
kn() { kubectl --namespace "${NAMESPACE}" "$@"; }

die() {
    echo "Error: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: labctl <command> [arguments]

  list                           All students with status, port and generation
  reassign <user>                Assign a new pod (home directory is kept)
  reset <user> [--new-password]  New pod and empty home (data is deleted)
  passwd <user> [password]       Change the password (random if omitted)
  add-student <user> [password] [port]
  remove-student <user> [--yes]  Delete pod, service, secret and home
  sync                           Create students from /etc/kubernetes-app/students.tsv
  wait-ready [--timeout <s>]     Wait until all student pods run (default 600 s)
  network peers <on|off>         Student pods reach each other (pentest)
  network internet <on|off>      Student pods reach the internet
  network status                 Show both network modes
  shell <user>                   Open a shell in the student's pod
  logs <user>                    Show the pod logs
EOF
}

valid_user() {
    [[ "$1" =~ ^[a-z]([a-z0-9-]{0,28}[a-z0-9])?$ ]] || die "Invalid user name '$1' (allowed: a-z, 0-9, -; starts with a letter, ends with a letter or digit; max. 30 characters)"
}

student_exists() { kn get deployment "student-$1" >/dev/null 2>&1; }

require_student() {
    valid_user "$1"
    student_exists "$1" || die "Student '$1' does not exist (labctl list)"
}

random_password() {
    local pw
    pw="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16 || true)"
    [ "${#pw}" -eq 16 ] || die "Could not generate a password"
    printf '%s' "${pw}"
}

node_ips() {
    # Internal addresses of the nodes, one per line.
    kc get nodes -o jsonpath='{range .items[*].status.addresses[?(@.type=="InternalIP")]}{.address}{"\n"}{end}'
}

generation_of() {
    kn get deployment "student-$1" \
        -o jsonpath='{.spec.template.metadata.annotations.lab-generation}' 2>/dev/null || true
}

namespace_label() {
    kc get namespace "${NAMESPACE}" -o jsonpath="{.metadata.labels.$1}" 2>/dev/null || true
}

# The namespace labels are authoritative, so add-student and sync do not reset
# a switched mode to the initial value from lab.env.
peer_mode() {
    local mode
    mode="$(namespace_label "${PEER_LABEL}")"
    case "${mode}" in
        open | isolated) echo "${mode}" ;;
        *) if [ "${POD_TO_POD}" = "true" ]; then echo open; else echo isolated; fi ;;
    esac
}

internet_mode() {
    local mode
    mode="$(namespace_label "${INTERNET_LABEL}")"
    case "${mode}" in
        allowed | blocked) echo "${mode}" ;;
        *) if [ "${POD_INTERNET}" = "true" ]; then echo allowed; else echo blocked; fi ;;
    esac
}

# --- Manifests -----------------------------------------------------------------

apply_namespace_and_policy() {
    local peers="${1:-}" internet="${2:-}" ip except4 except6 internet_rule=""
    [ -n "${peers}" ] || peers="$(peer_mode)"
    [ -n "${internet}" ] || internet="$(internet_mode)"

    # Egress to the internet only. Blocked in every mode: pod and service
    # network, the node itself (API, kubelet), link-local (the OpenStack
    # metadata service 169.254.169.254 serves user_data with passwords and
    # tokens) and the campus network. Pod traffic leaves the VM via NAT with
    # its public IP and would otherwise reach other VMs and the NodePorts of
    # other teams.
    if [ "${internet}" = "allowed" ]; then
        except4="\"${CLUSTER_CIDR_V4}\", \"${SERVICE_CIDR_V4}\", \"169.254.0.0/16\", \"${CAMPUS_CIDR_V4}\""
        except6="\"${CLUSTER_CIDR_V6}\", \"${SERVICE_CIDR_V6}\", \"fe80::/10\", \"${CAMPUS_CIDR_V6}\""
        while read -r ip; do
            [ -n "${ip}" ] || continue
            if [[ "${ip}" == *:* ]]; then
                except6="${except6}, \"${ip}/128\""
            else
                except4="${except4}, \"${ip}/32\""
            fi
        done < <(node_ips)
        internet_rule="
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except: [${except4}]
        - ipBlock:
            cidr: ::/0
            except: [${except6}]"
    fi

    # Ingress: SSH from outside the pod network. Egress: DNS always, the
    # internet only if allowed. Other pods are reachable only through
    # student-peer-access below.
    kc apply -f - <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: ${NAMESPACE}
  labels:
    ${PEER_LABEL}: ${peers}
    ${INTERNET_LABEL}: ${internet}
---
# DNS names <user>.students.${NAMESPACE}.svc.cluster.local for all ports.
apiVersion: v1
kind: Service
metadata:
  name: students
  namespace: ${NAMESPACE}
spec:
  clusterIP: None
  ipFamilyPolicy: PreferDualStack
  selector:
    role: student
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: student-isolation
  namespace: ${NAMESPACE}
spec:
  podSelector:
    matchLabels:
      role: student
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - ipBlock:
            cidr: 0.0.0.0/0
            except: ["${CLUSTER_CIDR_V4}"]
        - ipBlock:
            cidr: ::/0
            except: ["${CLUSTER_CIDR_V6}"]
      ports:
        - protocol: TCP
          port: 22
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53${internet_rule}
EOF

    # NetworkPolicies are additive: this second policy only opens traffic
    # between student pods, all blocks of student-isolation stay.
    if [ "${peers}" = "open" ]; then
        kc apply -f - <<EOF
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: student-peer-access
  namespace: ${NAMESPACE}
spec:
  podSelector:
    matchLabels:
      role: student
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              role: student
  egress:
    - to:
        - podSelector:
            matchLabels:
              role: student
EOF
    else
        kn delete networkpolicy student-peer-access --ignore-not-found
    fi
}

apply_pvc() {
    local user="$1"
    kc apply -f - <<EOF
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: home-${user}
  namespace: ${NAMESPACE}
  labels:
    role: student
    student: ${user}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: local-path
  resources:
    requests:
      storage: ${POD_DISK}
EOF
}

apply_secret() {
    local user="$1" password="$2"
    kn create secret generic "student-${user}" \
        --from-literal=password="${password}" \
        --dry-run=client -o yaml \
        | kn label --local -f - role=student "student=${user}" -o yaml \
        | kn apply -f -
}

apply_workload() {
    local user="$1" port="$2" generation="$3"
    kc apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: student-${user}
  namespace: ${NAMESPACE}
  labels:
    role: student
    student: ${user}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      role: student
      student: ${user}
  template:
    metadata:
      labels:
        role: student
        student: ${user}
      annotations:
        lab-generation: "${generation}"
    spec:
      hostname: ${user}
      subdomain: students
      automountServiceAccountToken: false
      enableServiceLinks: false
      terminationGracePeriodSeconds: 5
      securityContext:
        seccompProfile:
          type: RuntimeDefault
        sysctls:
          - name: net.ipv4.ping_group_range
            value: "0 2147483647"
      containers:
        - name: shell
          image: ${LAB_IMAGE}
          imagePullPolicy: IfNotPresent
          env:
            - name: STUDENT_USER
              value: ${user}
          ports:
            - name: ssh
              containerPort: 22
          securityContext:
            # sudo needs privilege escalation. NET_RAW (ARP/RA spoofing in the
            # pod network) and MKNOD are not needed and get dropped.
            allowPrivilegeEscalation: true
            privileged: false
            capabilities:
              drop: ["NET_RAW", "MKNOD"]
          resources:
            requests:
              cpu: "${POD_CPU}"
              memory: ${POD_MEMORY}
            limits:
              cpu: "${POD_CPU}"
              memory: ${POD_MEMORY}
              ephemeral-storage: ${POD_EPHEMERAL_LIMIT}
          readinessProbe:
            tcpSocket:
              port: ssh
            initialDelaySeconds: 2
            periodSeconds: 3
          volumeMounts:
            - name: home
              mountPath: /home/${user}
            - name: password
              mountPath: /etc/student
              readOnly: true
      volumes:
        - name: home
          persistentVolumeClaim:
            claimName: home-${user}
        - name: password
          secret:
            secretName: student-${user}
            items:
              - key: password
                path: password
---
apiVersion: v1
kind: Service
metadata:
  name: student-${user}
  namespace: ${NAMESPACE}
  labels:
    role: student
    student: ${user}
spec:
  type: NodePort
  # Local: the client address is preserved, so the NetworkPolicy (pod
  # network blocked) lets external clients through.
  externalTrafficPolicy: Local
  ipFamilyPolicy: PreferDualStack
  selector:
    role: student
    student: ${user}
  ports:
    - name: ssh
      port: 22
      targetPort: ssh
      nodePort: ${port}
EOF
}

# --- Helpers -------------------------------------------------------------------

used_ports() {
    kn get service -l role=student -o jsonpath='{range .items[*]}{.spec.ports[0].nodePort}{"\n"}{end}' 2>/dev/null || true
}

next_free_port() {
    local port used
    used="$(used_ports)"
    for ((port = FIRST_PORT; port <= LAST_PORT; port++)); do
        if ! grep -qx "${port}" <<<"${used}"; then
            echo "${port}"
            return
        fi
    done
    die "No free NodePort left between ${FIRST_PORT} and ${LAST_PORT}"
}

all_students() {
    kn get deployment -l role=student -o jsonpath='{range .items[*]}{.metadata.labels.student}{"\n"}{end}' | sort
}

is_ready() {
    [ "$(kn get deployment "student-$1" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || true)" = "1" ]
}

# One line explaining why the pod of a student is not ready, e.g.
# "Pending, Unschedulable: 0/1 nodes are available: 1 Insufficient memory."
pod_problem() {
    local problem
    problem="$(kn get pods -l "student=$1" -o jsonpath='{.items[0].status.phase}{range .items[0].status.conditions[?(@.status=="False")]}, {.reason}: {.message}{end}{range .items[0].status.containerStatuses[*]}, {.state.waiting.reason} {.state.waiting.message}{.state.terminated.reason}{end}' 2>/dev/null || true)"
    problem="$(tr -s ' \n' ' ' <<<"${problem}")"
    echo "${problem:-no pod}"
}

wait_ready() {
    kn rollout status "deployment/student-$1" --timeout=180s
}

# --- Commands ------------------------------------------------------------------

cmd_list() {
    local user port gen pod phase age
    printf '%-24s %-8s %-4s %-30s %-10s\n' STUDENT PORT GEN POD STATUS
    while read -r user; do
        [ -n "${user}" ] || continue
        port="$(kn get service "student-${user}" -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo '-')"
        gen="$(generation_of "${user}")"
        pod="$(kn get pods -l "student=${user}" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
        phase="$(kn get pods -l "student=${user}" -o jsonpath='{.items[0].status.phase}' 2>/dev/null || true)"
        age="$(kn get pods -l "student=${user}" -o jsonpath='{.items[0].metadata.creationTimestamp}' 2>/dev/null || true)"
        printf '%-24s %-8s %-4s %-30s %-10s %s\n' "${user}" "${port}" "${gen:--}" "${pod:--}" "${phase:-none}" "${age}"
    done < <(all_students)
}

cmd_add_student() {
    local user="${1:-}" password="${2:-}" port="${3:-}"
    [ -n "${user}" ] || die "Usage: labctl add-student <user> [password] [port]"
    valid_user "${user}"
    student_exists "${user}" && die "Student '${user}' already exists"
    [ -n "${password}" ] || password="$(random_password)"
    [ -n "${port}" ] || port="$(next_free_port)"
    if ! [[ "${port}" =~ ^[0-9]+$ ]] || [ "${port}" -lt 30000 ] || [ "${port}" -gt "${LAST_PORT}" ]; then
        die "Port must be between 30000 and ${LAST_PORT}"
    fi
    if grep -qx "${port}" <<<"$(used_ports)"; then
        die "Port ${port} is already in use"
    fi

    apply_namespace_and_policy
    apply_pvc "${user}"
    apply_secret "${user}" "${password}"
    apply_workload "${user}" "${port}" 1
    echo "Student '${user}' created: port ${port}, password ${password}"
    if ! kn rollout status "deployment/student-${user}" --timeout=60s >/dev/null 2>&1; then
        echo "Warning: pod of '${user}' is not ready yet: $(pod_problem "${user}")" >&2
        echo "         If it stays Pending, the VM is full (labctl list)." >&2
    fi
}

cmd_remove_student() {
    local user="${1:-}" confirm="${2:-}"
    [ -n "${user}" ] || die "Usage: labctl remove-student <user> [--yes]"
    require_student "${user}"
    if [ "${confirm}" != "--yes" ]; then
        read -r -p "Delete all data of '${user}'? [yes/NO] " answer
        [ "${answer}" = "yes" ] || die "Aborted"
    fi
    kn delete deployment,service,secret "student-${user}" --ignore-not-found
    kn wait --for=delete pod -l "student=${user}" --timeout=60s || true
    kn delete pvc "home-${user}" --ignore-not-found
    echo "Student '${user}' removed"
}

bump_generation() {
    local user="$1" gen
    gen="$(generation_of "${user}")"
    echo $((${gen:-0} + 1))
}

cmd_reassign() {
    local user="${1:-}" gen
    [ -n "${user}" ] || die "Usage: labctl reassign <user>"
    require_student "${user}"
    gen="$(bump_generation "${user}")"
    # A changed pod template annotation starts a new pod. With the "Recreate"
    # strategy the old pod is stopped first.
    kn patch deployment "student-${user}" --type merge \
        -p "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"lab-generation\":\"${gen}\"}}}}}"
    wait_ready "${user}"
    echo "New pod for '${user}' (generation ${gen}), home directory unchanged"
}

cmd_reset() {
    local user="${1:-}" newpw="${2:-}" gen
    [ -n "${user}" ] || die "Usage: labctl reset <user> [--new-password]"
    require_student "${user}"
    gen="$(bump_generation "${user}")"

    kn scale "deployment/student-${user}" --replicas=0
    kn wait --for=delete pod -l "student=${user}" --timeout=60s || true
    kn delete pvc "home-${user}" --wait=true
    apply_pvc "${user}"
    if [ "${newpw}" = "--new-password" ]; then
        local password
        password="$(random_password)"
        apply_secret "${user}" "${password}"
        echo "New password for '${user}': ${password}"
    fi
    kn patch deployment "student-${user}" --type merge \
        -p "{\"spec\":{\"replicas\":1,\"template\":{\"metadata\":{\"annotations\":{\"lab-generation\":\"${gen}\"}}}}}"
    wait_ready "${user}"
    echo "'${user}' reset (generation ${gen}), home directory is empty"
}

cmd_passwd() {
    local user="${1:-}" password="${2:-}"
    [ -n "${user}" ] || die "Usage: labctl passwd <user> [password]"
    require_student "${user}"
    [ -n "${password}" ] || password="$(random_password)"
    apply_secret "${user}" "${password}"
    cmd_reassign "${user}"
    echo "New password for '${user}': ${password}"
}

cmd_sync() {
    [ -r "${STUDENTS_FILE}" ] || die "${STUDENTS_FILE} is not readable"
    apply_namespace_and_policy
    local user password port
    while read -r user password port; do
        [ -n "${user}" ] || continue
        case "${user}" in \#*) continue ;; esac
        if student_exists "${user}"; then
            echo "skipped: ${user} (exists)"
            continue
        fi
        valid_user "${user}"
        apply_pvc "${user}"
        apply_secret "${user}" "${password}"
        apply_workload "${user}" "${port}" 1
        echo "created: ${user} (port ${port})"
    done <"${STUDENTS_FILE}"
}

# Waits until every student pod is ready. On timeout it prints one line per
# pod that is not ready and exits non-zero; the first-boot script turns that
# into the APPSTORE-FAILED marker for the platform.
cmd_wait_ready() {
    local timeout=600 deadline user students pending
    if [ "${1:-}" = "--timeout" ]; then
        [[ "${2:-}" =~ ^[0-9]+$ ]] || die "Usage: labctl wait-ready [--timeout <seconds>]"
        timeout="$2"
    fi
    students="$(all_students)"
    if [ -z "${students}" ]; then
        echo "ready: no students"
        return 0
    fi
    deadline=$((SECONDS + timeout))
    while :; do
        pending=""
        while read -r user; do
            [ -n "${user}" ] || continue
            is_ready "${user}" || pending="${pending} ${user}"
        done <<<"${students}"
        [ -n "${pending}" ] || break
        if [ "${SECONDS}" -ge "${deadline}" ]; then
            for user in ${pending}; do
                echo "not ready: student-${user}: $(pod_problem "${user}")" >&2
            done
            return 1
        fi
        sleep 5
    done
    echo "ready: $(wc -l <<<"${students}" | tr -d ' ') students"
}

on_off() {
    case "$1" in
        on) echo "$2" ;;
        off) echo "$3" ;;
        *) return 1 ;;
    esac
}

cmd_network() {
    local what="${1:-status}" value="${2:-}" mode
    case "${what}" in
        peers)
            mode="$(on_off "${value}" open isolated)" || die "Usage: labctl network peers <on|off>"
            apply_namespace_and_policy "${mode}" "$(internet_mode)"
            ;;
        internet)
            mode="$(on_off "${value}" allowed blocked)" || die "Usage: labctl network internet <on|off>"
            apply_namespace_and_policy "$(peer_mode)" "${mode}"
            ;;
        status) ;;
        *) die "Usage: labctl network <peers|internet> <on|off> | labctl network status" ;;
    esac
    echo "Pod-to-pod communication: $(peer_mode)"
    echo "Internet access:          $(internet_mode)"
}

cmd_shell() {
    local user="${1:-}"
    [ -n "${user}" ] || die "Usage: labctl shell <user>"
    require_student "${user}"
    exec kubectl --namespace "${NAMESPACE}" exec -it "deployment/student-${user}" -- su - "${user}"
}

cmd_logs() {
    local user="${1:-}"
    [ -n "${user}" ] || die "Usage: labctl logs <user>"
    require_student "${user}"
    kn logs "deployment/student-${user}" --tail=200
}

main() {
    local command="${1:-}"
    [ -n "${command}" ] || {
        usage
        exit 1
    }
    shift
    case "${command}" in
        list) cmd_list "$@" ;;
        reassign) cmd_reassign "$@" ;;
        reset) cmd_reset "$@" ;;
        passwd) cmd_passwd "$@" ;;
        add-student) cmd_add_student "$@" ;;
        remove-student) cmd_remove_student "$@" ;;
        sync) cmd_sync "$@" ;;
        wait-ready) cmd_wait_ready "$@" ;;
        network) cmd_network "$@" ;;
        shell) cmd_shell "$@" ;;
        logs) cmd_logs "$@" ;;
        -h | --help | help) usage ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"
