# Copy to terraform.tfvars (listed in .gitignore) and adjust.
# The platform worker normally injects users and image_name itself.

# One course = one team = one VM with a k3s cluster.
users = {
  kurs = [
    { email = "anna.mueller@example.com" },
    { email = "ben.schmidt@example.com" },
    { email = "carla.meier@example.com" },
  ]
}

image_name  = "kubernetes-app-v0.1.0"
flavor_name = "gp1.large"

# Optional: SSH access to the VM (user ubuntu) for troubleshooting.
# key_pair_name = "erik-dev"

# Optional: larger disk for the home directories.
# root_disk_gb = 100

# Networks allowed to reach SSH and the API (campus/VPN).
# allowed_cidr_v4 = "141.72.0.0/16"
# allowed_cidr_v6 = "2001:7c0::/32"

# Pentest mode: student pods can reach each other (later: labctl network).
# allow_pod_communication = true
