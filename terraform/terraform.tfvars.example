# Copy to terraform.tfvars (listed in .gitignore) and adjust.
# The platform worker normally injects users and image_name itself.

# One course = one team = one VM with a k3s cluster.
users = {
  kurs = [
    { email = "anna.mueller@example.com" },
    { email = "ben.schmidt@example.com" },
    { email = "carla.meier@example.com" },
  ]
}

image_name = "kubernetes-app-v0.1.0"

# Resources of the whole VM. The plan fails if the students do not fit.
flavor_name = "gp1.large"
# root_disk_gb = 40    # default; 0 = disk of the flavor (gp1.large: only 10 GB)

# Resources per student pod (reserved, request = limit).
# pod_cpu       = 0.5
# pod_memory_mb = 1024
# pod_disk_gb   = 5

# Network of the student pods (switchable later with `labctl network`).
# allow_pod_communication = true   # pods reach each other (pentest)
# allow_internet          = false  # no internet, only DNS

# Optional: SSH access to the VM (user ubuntu) for debugging.
# key_pair_name = "erik-dev"
